<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/client_detail_title"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <TextView
                    android:id="@+id/tvDettaglioCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Parere / relazione con l'AI a partire dai documenti della cartella Mega della pratica. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnParereMega"
                style="@style/PulsanteRuotaPrimario"
                android:layout_marginTop="20dp"
                app:backgroundTint="@color/primary"
                android:text="📄  Parere / relazione dai documenti Mega" />

            <TextView
                android:id="@+id/tvAvvisoMega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#3A4540"
                android:visibility="gone"
                android:text="Per usarlo, modifica la scheda (tieni premuto sul cliente nella lista) e incolla il link della cartella Mega." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnElimina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Elimina scheda cliente"
                app:backgroundTint="#B3261E" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
